# Copia este archivo como `.env` para ajustar el arranque de docker-compose.
# Todos tienen un valor por defecto que sirve para desarrollo local, así que
# `docker compose up --build` funciona sin crear el archivo.

# Secreto con el que ms-auth firma el token y el gateway lo valida.
# En algo real sería un valor largo y aleatorio, y no estaría en el repositorio.
JWT_SECRET=secreto-de-desarrollo

# Base de los enlaces privados que se mandan al cliente.
URL_PUBLICA=http://localhost:8080

# Dirección del almacén de archivos tal como la ve el navegador,
# para que las URLs firmadas se puedan abrir.
ALMACEN_ENDPOINT_PUBLICO=http://localhost:9000
